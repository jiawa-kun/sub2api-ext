# Docker image (GHCR)
# 默认不指定，compose 自动使用 ghcr.io/jiawa-kun/sub2api-ext:latest
# 仅在需要回滚/固定版本时取消注释，部署脚本加 -Image 也会自动写入这一行
# IMAGE=ghcr.io/jiawa-kun/sub2api-ext:sha-xxxxxxx

# Sub2API 扩展（产品 sub2api-ext，项目名 sub2api-ext）
# 默认路径前缀 /ext；扩展中心页：/ext/home.html
# 复制为 .env 后填写（不要提交 .env）
#
# 管理员凭证（二选一，推荐 API Key）：
# 1) 管理员 API Key（Sub2API 后台「管理员 API Key / 外部系统集成」）—— 长期有效，推荐
#    写入下方任一变量即可（API Key 会通过 x-api-key 发送）
#    也可在管理页 /admin.html「服务端 Admin API Key」直接配置（SQLite 覆盖优先于本 env）
SUB2API_ADMIN_API_KEY=
# 2) 或管理员登录后的 JWT auth_token（会过期，不推荐长期用）
SUB2API_ADMIN_TOKEN=

# 用户在 AI 创作中保存的 Sub2API API Key 使用此密钥加密。
# 生产环境必须设置至少 32 个随机字符；设置后不要随意更换，否则已有 Key 无法解密。
CREATIVE_CREDENTIAL_SECRET=

# Creative media storage (optional)
# local (default) keeps files under SQLITE_PATH sibling creative/images|videos
# webdav stores into AList/WebDAV (e.g. Google Drive mount). Access still goes through this service auth.
# CREATIVE_MEDIA_DRIVER=local
# CREATIVE_MEDIA_ROOT=
# CREATIVE_WEBDAV_URL=https://alist.example.com/dav/
# CREATIVE_WEBDAV_USERNAME=
# CREATIVE_WEBDAV_PASSWORD=
# CREATIVE_WEBDAV_ROOT=
# Keep reading old local files after switching to webdav until migration finishes (default true)
# CREATIVE_MEDIA_LOCAL_FALLBACK=true

CHECKIN_ENABLED=true
CHECKIN_REWARD_AMOUNT=0.1
CHECKIN_TIMEZONE=Asia/Shanghai
# 容器内访问 sub2api（同 docker 网络）
SUB2API_BASE_URL=http://sub2api:8080
# Optional external host when BASE_URL is internal (docker service name)
# SUB2API_PUBLIC_HOST=your-sub2api.example.com


# Security / rate limit
# CORS_ORIGINS=https://your-sub2api.example.com
# RATE_CHECKIN_PER_MIN=10
# RATE_ADMIN_WRITE_PER_MIN=30
# SENSITIVE_WRITE_REQUIRE_API_KEY=true


# Account model patrol (optional; also configurable in admin.html)
# PATROL_ENABLED=false
# PATROL_CRON=0 */6 * * *
# PATROL_GROUPS=group-a,group-b
# PATROL_TEST_MODEL=gpt-5.4
# PATROL_CONCURRENCY=8
# PATROL_TIMEOUT_MS=45000
# PATROL_ACTION_ON_FAIL=disable
# 连续失败多少次才执行失败动作（1..10）。1=一次失败即处置（旧行为），建议 2 以避免上游抖动误杀
# PATROL_FAIL_THRESHOLD=1
# PATROL_ONLY_SCHEDULABLE=false
# PATROL_STOP_ON_FIRST_FAILURE=true
# PATROL_PROMPT=hi
# PATROL_AUTO_ENABLE_ON_SUCCESS=true
# PATROL_TIMEZONE=Asia/Shanghai
# PATROL_KEEP_RUNS=50

# Notification center (optional; also configurable in admin.html#notify)
# NOTIFY_ENABLED=false
# webhook | wecom | telegram
# NOTIFY_CHANNEL=webhook
# Webhook URL, or bot token when NOTIFY_CHANNEL=telegram
# NOTIFY_TARGET=
# Telegram chat id
# NOTIFY_EXTRA=
# Sent as Authorization: Bearer <secret>
# NOTIFY_SECRET=
# info | warn | error
# NOTIFY_MIN_LEVEL=warn
# NOTIFY_EVENTS=patrol.run_finished,patrol.account_action,checkin.budget_exhausted,lottery.budget_exhausted,settings.changed

# Lucky draw (optional; also configurable in admin.html#lottery)
# LOTTERY_ENABLED=false
# LOTTERY_REQUIRE_CHECKIN=true
# LOTTERY_DAILY_BUDGET=0
# LOTTERY_HARD_CAP=0

# Daily operations report (optional; also configurable in admin.html#report)
# REPORT_ENABLED=false
# REPORT_SEND_AT=09:00
# REPORT_TIMEZONE=Asia/Shanghai
# REPORT_COVER_DAY=yesterday
# REPORT_SECTIONS=checkin,lottery,patrol
